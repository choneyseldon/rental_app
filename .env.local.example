# Written automatically by `npx convex dev` — this file is a reference copy.
# Looks like: https://your-project-123.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# The admin passcode, compared server-side only.
ADMIN_PASSCODE=

# Signs the admin session cookie. Any long random string.
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Shared secret gating every function in convex/admin.ts. It must be set in
# BOTH places, to the same value:
#   here (server-side only, deliberately not NEXT_PUBLIC_), and
#   on the deployment:  npx convex env set ADMIN_API_SECRET <value>
ADMIN_API_SECRET=
